{
  "name": "frameline",
  "version": "0.1.0",
  "description": "A small, dependency-free timeline for marking time: frame-exact, SMPTE timecode (drop-frame included), keyframes on rows, and a synchronization model built to follow any clock.",
  "keywords": [
    "timeline",
    "keyframes",
    "timecode",
    "smpte",
    "drop-frame",
    "broadcast",
    "animation",
    "sync"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/frameline.js",
  "module": "dist/frameline.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/frameline.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo --host 127.0.0.1 --strictPort --port 5373",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/write-css.mjs",
    "example": "vite examples/minimal --host 127.0.0.1 --strictPort --port 5374",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "smpte-timecode": "1.3.6",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "5.1.1",
    "@types/node": "24.10.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedeblock/frameline.git"
  }
}
